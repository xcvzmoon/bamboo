{
  "name": "create-tauri-app-nuxt",
  "description": "Create application using Tauri with Nuxt",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tauri build",
    "dev": "tauri-nuxt-dev",
    "postinstall": "pnpm nuxt:postinstall",
    "typecheck": "pnpm nuxt:typecheck",
    "fmt": "run-p oxc:fmt cargo:fmt",
    "lint": "run-p oxc:lint cargo:lint",
    "check": "run-p oxc:check cargo:check",
    "test": "run-s cargo:test",
    "validate": "run-s fmt lint check typecheck test",
    "release": "genbumppush --yes",
    "oxc:fmt": "oxfmt",
    "oxc:check": "oxfmt --check",
    "oxc:lint": "oxlint",
    "cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "cargo:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "cargo:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "cargo:clean": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "cargo:clean:release": "cargo clean --release --manifest-path src-tauri/Cargo.toml",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "nuxt:build": "nuxt build",
    "nuxt:dev": "nuxt dev",
    "nuxt:generate": "nuxt generate",
    "nuxt:preview": "nuxt preview",
    "nuxt:postinstall": "nuxt prepare",
    "nuxt:typecheck": "nuxt typecheck",
    "add-component": "shadcn-vue add"
  },
  "dependencies": {
    "@lucide/vue": "^1.56.0",
    "@nuxt/icon": "2.5.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuxt": "^4.6.1",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "2.8.2",
    "tailwind-merge": "^3.7.0",
    "valibot": "^1.5.0",
    "vue": "^3.5.44",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@golar/vue": "^0.1.10",
    "@iconify-json/hugeicons": "^1.2.35",
    "@nuxtjs/color-mode": "^4.0.1",
    "@oxlint/plugins": "^1.88.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "genbumppush": "^0.0.8",
    "golar": "^0.1.10",
    "lefthook": "^2.2.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tauri-nuxt-dev": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
